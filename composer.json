{
    "name": "daika7ana/mobilpay",
    "description": "MobilPay (Netopia) payments for Laravel through the omnipay-mobilpay driver",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "adrianbarbos",
            "email": "ady.barbos@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "omnipay/common": "^3.0",
        "daika7ana/omnipay-mobilpay": "^1.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Adrianbarbos\\Mobilpay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Adrianbarbos\\Mobilpay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Adrianbarbos\\Mobilpay\\MobilpayServiceProvider"
            ],
            "aliases": {
                "Omnipay": "Omnipay\\Omnipay",
                "Mobilpay": "Adrianbarbos\\Mobilpay\\Mobilpay"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
